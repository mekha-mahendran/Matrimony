l:'\u0bae\u0bb0\u0baa\u0bc1\u0bb5\u0bb4\u0bbf \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0bae\u0bcd',moderate:'\u0ba8\u0bb5\u0bc0\u0ba9 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd\u0baf\u0bae\u0bcd',liberal:'\u0bae\u0bc1\u0bb1\u0bcd\u0baa\u0bcb\u0b95\u0bcd\u0b95\u0bbe\u0ba9\u0ba4\u0bc1',fatherOccupation:'\u0ba4\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bcd',motherOccupation:'\u0ba4\u0bbe\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bcd',siblings:'\u0b89\u0b9f\u0ba9\u0bcd\u0baa\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',diet:'\u0b89\u0ba3\u0bb5\u0bc1 \u0bae\u0bc1\u0bb1\u0bc8',vegetarian:'\u0b9a\u0bc8\u0bb5\u0bae\u0bcd',nonVegetarian:'\u0b85\u0b9a\u0bc8\u0bb5\u0bae\u0bcd',eggetarian:'\u0bae\u0bc1\u0b9f\u0bcd\u0b9f\u0bc8 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd',aboutMe:'\u0bb5\u0bb0\u0ba9\u0bcd & \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa \u0b85\u0bb1\u0bbf\u0bae\u0bc1\u0b95\u0bae\u0bcd',horoscopeTitle:'\u0b9c\u0bbe\u0ba4\u0b95\u0bae\u0bcd & \u0ba8\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd',rasi:'\u0bb0\u0bbe\u0b9a\u0bbf',nakshatram:'\u0ba8\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd',lagnam:'\u0bb2\u0b95\u0bcd\u0ba9\u0bae\u0bcd',chevvaiDosham:'\u0b9a\u0bc6\u0bb5\u0bcd\u0bb5\u0bbe\u0baf\u0bcd \u0ba4\u0bcb\u0bb7\u0bae\u0bcd',sarpaDosham:'\u0bb0\u0bbe\u0b95\u0bc1-\u0b95\u0bc7\u0ba4\u0bc1 / \u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa \u0ba4\u0bcb\u0bb7\u0bae\u0bcd',horoscopeMatchEngine:'\u0baa\u0ba4\u0bcd\u0ba4\u0bc1 \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0b95\u0bbe\u0bb2\u0bcd\u0b95\u0bc1\u0bb2\u0bc7\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd',calculatePorutham:'\u0b9c\u0bbe\u0ba4\u0b95\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95',poruthamScore:'\u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0ba3\u0bcd',poruthamAuspicious:'\u0b89\u0ba4\u0bcd\u0ba4\u0bae \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd (\u0bae\u0bbf\u0b95\u0b9a\u0bcd \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1)',poruthamMedium:'\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bae \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd (\u0b8f\u0bb1\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0ba4\u0bc1)',poruthamLow:'\u0b9c\u0bcb\u0ba4\u0bbf\u0b9f\u0bb0\u0bc8 \u0b95\u0bb2\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcb\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',greetingMorning:'\u0b95\u0bbe\u0bb2\u0bc8 \u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd',greetingDay:'\u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd',profileScore:'\u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0 \u0ba8\u0bbf\u0bb1\u0bc8\u0bb5\u0bc1 \u0b9a\u0ba4\u0bb5\u0bc0\u0ba4\u0bae\u0bcd',dailyRecommendations:'\u0b87\u0ba9\u0bcd\u0bb1\u0bc8\u0baf \u0b9a\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0ba9\u0bcd\u0b95\u0bb3\u0bcd',recentlyJoined:'\u0baa\u0bc1\u0ba4\u0bbf\u0ba4\u0bbe\u0b95 \u0b87\u0ba3\u0bc8\u0ba8\u0bcd\u0ba4 \u0ba4\u0bae\u0bbf\u0bb4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd',premiumMembers:'\u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0bb5\u0bb0\u0ba9\u0bcd\u0b95\u0bb3\u0bcd',whoViewedYou:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd',newMatchesForYou:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc7\u0bb1\u0bcd\u0bb1 \u0bb5\u0bb0\u0ba9\u0bcd\u0b95\u0bb3\u0bcd',interestsOverview:'\u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa \u0ba8\u0bbf\u0bb2\u0bb5\u0bb0\u0bae\u0bcd',sentCount:'\u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bb5\u0bc8',receivedCount:'\u0bb5\u0ba8\u0bcd\u0ba4\u0bb5\u0bc8',acceptedCount:'\u0b8f\u0bb1\u0bcd\u0bb1\u0bb5\u0bc8',searchPlaceholder:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b8e\u0ba3\u0bcd, \u0b9a\u0bae\u0bc2\u0b95\u0bae\u0bcd, \u0baa\u0ba3\u0bbf, \u0b8a\u0bb0\u0bcd \u0ba4\u0bc7\u0b9f\u0bb5\u0bc1\u0bae\u0bcd...',ageRange:'\u0bb5\u0baf\u0ba4\u0bc1 \u0bb5\u0bb0\u0bae\u0bcd\u0baa\u0bc1',heightRange:'\u0b89\u0baf\u0bb0 \u0bb5\u0bb0\u0bae\u0bcd\u0baa\u0bc1',educationFilter:'\u0b95\u0bb2\u0bcd\u0bb5\u0bbf',cityFilter:'\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd / \u0b8a\u0bb0\u0bcd',casteFilter:'\u0b9a\u0bae\u0bc2\u0b95 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0bcd',verifiedOnly:'\u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd',withPhotoOnly:'\u0baa\u0bc1\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0bc8 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd',horoscopeCompatible:'\u0b9c\u0bbe\u0ba4\u0b95 \u0baa\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0bc8 (7+)',resultsFound:'\u0bb5\u0bb0\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba9',membershipPlans:'\u0bae\u0ba3\u0bae\u0bbe\u0bb2\u0bc8 \u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd',freePlan:'\u0b87\u0bb2\u0bb5\u0b9a \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd',silverPlan:'\u0b9a\u0bbf\u0bb2\u0bcd\u0bb5\u0bb0\u0bcd \u0b95\u0bb2\u0bcd\u0baf\u0bbe\u0ba3\u0bae\u0bcd',goldPlan:'\u0b95\u0bcb\u0bb2\u0bcd\u0b9f\u0bcd \u0bae\u0bbe\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0baf\u0bae\u0bcd',premiumPlan:'\u0baa\u0bbf\u0bb3\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bae\u0bcd \u0bae\u0ba3\u0bae\u0bbe\u0bb2\u0bc8',upgradeNow:'\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8 \u0bae\u0bc7\u0bae\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95',contactUnlocked:'\u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1 \u0b8e\u0ba3\u0bcd \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',contactLocked:'\u0ba4\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1 \u0b8e\u0ba3\u0bcd\u0ba3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0ba3 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8 \u0bae\u0bc7\u0bae\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb5\u0bc1\u0bae\u0bcd',hidePhone:'\u0b87\u0bb0\u0bc1\u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0b9a\u0bae\u0bcd\u0bae\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bc7 \u0ba4\u0bca\u0bb2\u0bc8\u0baa\u0bc7\u0b9a\u0bbf \u0b8e\u0ba3\u0bcd\u0ba3\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1',hideHoroscope:'\u0b9c\u0bbe\u0ba4\u0b95\u0ba4\u0bcd\u0ba4\u0bc8 \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bbf\u0bb0\u0bcd\u0b95',adminPortal:'\u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95 \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bc8\u0baf\u0bae\u0bcd',totalMembers:'\u0bae\u0bca\u0ba4\u0bcd\u0ba4 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd',pendingVerifications:'\u0ba8\u0bbf\u0bb2\u0bc1\u0bb5\u0bc8 \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',reportedAccounts:'\u0baa\u0bc1\u0b95\u0bbe\u0bb0\u0bcd \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8',activeSubscriptions:'\u0b95\u0b9f\u0bcd\u0b9f\u0ba3 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bcd',approveVerification:'\u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc8 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0b9a\u0bc6\u0baf\u0bcd',rejectVerification:'\u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf',suspendMember:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc8 \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0bc1'}}},528);
